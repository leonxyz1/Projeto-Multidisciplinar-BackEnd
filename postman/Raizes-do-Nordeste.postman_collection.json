  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "cliente@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "senha123",
                  "type": "text"
                }
              ]
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Resposta contém token bearer', function () { pm.expect(body.token_type).to.eql('bearer'); });",
                  "pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('clienteToken', body.access_token);"
                ]
              }
            }
          ],
          "description": "Autentica o usuario CLIENTE de demonstracao. Salva o token em clienteToken, usado pelas requisicoes de pedidos e erros."
        },
        {
          "name": "Login - gerente",
          "request": {
            "method": "POST",
            "header": [
