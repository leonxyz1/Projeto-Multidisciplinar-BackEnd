    {
      "name": "Unidades e Produtos",
      "item": [
        {
          "name": "Listar unidades e guardar ID da Unidade Centro",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/unidades"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Resposta lista unidades', function () { pm.expect(body).to.be.an('array').that.is.not.empty; });",
                  "const unit = body.find((item) => item.nome === 'Unidade Centro');",
                  "pm.expect(unit, 'Unidade Centro do seed').to.exist;",
                  "pm.collectionVariables.set('unidadeCentroId', String(unit.id));"
                ]
              }
            }
          ],
          "description": "Lista unidades ativas e salva o ID da Unidade Centro em unidadeCentroId para as requisicoes seguintes. Requer o seed do banco.",
