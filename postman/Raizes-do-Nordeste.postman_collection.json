            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Resposta informa expiracao do token', function () { pm.expect(body.expires_in).to.be.a('number').and.above(0); });",
                  "pm.expect(body.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('gerenteToken', body.access_token);"
                ]
              }
            }
          ],
          "description": "Autentica o usuario GERENTE de demonstracao. Salva o token em gerenteToken, usado na consulta de auditoria e na transicao de status."
        }
