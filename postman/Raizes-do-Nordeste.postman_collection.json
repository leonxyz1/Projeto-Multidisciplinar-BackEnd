        {
          "name": "Criar pedido - canal APP",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canalPedido\": \"APP\",\n  \"unidadeId\": {{unidadeCentroId}},\n  \"itens\": [\n    { \"produtoId\": {{produtoDisponivelId}}, \"quantidade\": 1 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/pedidos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Pedido criado aguardando pagamento', function () { pm.expect(body.status).to.eql('AGUARDANDO_PAGAMENTO'); });",
                  "pm.expect(body.id).to.be.a('number');",
                  "pm.collectionVariables.set('pedidoId', String(body.id));"
