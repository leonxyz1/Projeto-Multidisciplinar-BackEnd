        {
          "name": "Listar produtos e guardar IDs do seed",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/unidades/{{unidadeCentroId}}/produtos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Resposta contém itens e total', function () { pm.expect(body.items).to.be.an('array').that.is.not.empty; pm.expect(body.meta.total).to.be.above(0); });",
                  "const available = body.items.find((item) => item.sku === 'TESTE-001');",
                  "const unavailable = body.items.find((item) => item.sku === 'TESTE-003');",
                  "pm.expect(available, 'Produto TESTE-001 do seed').to.exist;",
                  "pm.expect(unavailable, 'Produto TESTE-003 do seed').to.exist;",
                  "pm.collectionVariables.set('produtoDisponivelId', String(available.id));",
                  "pm.collectionVariables.set('produtoSemEstoqueId', String(unavailable.id));"
                ]
              }
            }
          ],
          "description": "Lista produtos e estoque da unidade selecionada. Salva em variaveis os IDs do produto disponivel e do produto sem estoque.",
